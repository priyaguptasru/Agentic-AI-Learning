                        {
                            "paragraph_id": 75,
                            "text": "Deploying the Sample"
                        },
                        {
                            "paragraph_id": 76,
                            "text": "To deploy this sample in your environment:"
                        },
                        {
                            "paragraph_id": 77,
                            "text": "1. Open the template design ap_bookmark.IFD in Output Designer and recompile the"
                        },
                        {
                            "paragraph_id": 78,
                            "text": "template for the appropriate presentment target."
                        },
                        {
                            "paragraph_id": 79,
                            "text": "2. Modify the -z option in the ^job command in the data file ap_bookmark.dat to:"
                        },
                        {
                            "paragraph_id": 80,
                            "text": "•"
                        },
                        {
                            "paragraph_id": 81,
                            "text": "Identify the target output device."
                        },
                        {
                            "paragraph_id": 82,
                            "text": "•"
                        },
                        {
                            "paragraph_id": 83,
                            "text": "Identify the bookmark file using the -abmk command."
                        },
                        {
                            "paragraph_id": 84,
                            "text": "•"
                        },
                        {
                            "paragraph_id": 85,
                            "text": "Identify the section for which to generate bookmarks, if desired, using the -abms"
                        },
                        {
                            "paragraph_id": 86,
                            "text": "command."
                        },
                        {
                            "paragraph_id": 87,
                            "text": "For example,"
                        },
                        {
                            "paragraph_id": 88,
                            "text": "To bookmark by …"
                        },
                        {
                            "paragraph_id": 89,
                            "text": "Use the command line parameter …"
                        }
                    ]
                },
                {
                    "section_id": 17,
                    "header": "Invoices",
                    "paragraphs": [
                        {
                            "paragraph_id": 90,
                            "text": "-abmkap_bookmark.bmk -abmsinvoices"
                        }
                    ]
                },
                {
                    "section_id": 18,
                    "header": "Type",
                    "paragraphs": [
                        {
                            "paragraph_id": 91,
                            "text": "-abmkap_bookmark.bmk -abmstype"
