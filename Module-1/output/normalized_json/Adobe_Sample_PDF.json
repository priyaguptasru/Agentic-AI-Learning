                {
                    "paragraph_id": 97,
                    "text": "3. Place the accompanying files in directories consistent with your implementation:"
                },
                {
                    "paragraph_id": 98,
                    "text": "•"
                },
                {
                    "paragraph_id": 99,
                    "text": "Place ap_bookmark.IFD in the Designs subdirectory for Output Designer."
                },
                {
                    "paragraph_id": 100,
                    "text": "•"
                },
                {
                    "paragraph_id": 101,
                    "text": "Place ap_bookmark.mdf in the forms subdirectory accessible to Central."
                },
                {
                    "paragraph_id": 102,
                    "text": "•"
                },
                {
                    "paragraph_id": 103,
                    "text": "Place ap_bookmark.bmk in an addressable directory."
                },
                {
                    "paragraph_id": 104,
                    "text": "Running the Sample"
                },
                {
                    "paragraph_id": 105,
                    "text": "•"
                },
                {
                    "paragraph_id": 106,
                    "text": "To run this sample, place ap_bookmark.dat in the collector directory scanned by Central."
                }
